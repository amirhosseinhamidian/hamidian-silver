generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String                  @id @default(uuid()) @db.Uuid
  phone                          String                  @unique @db.VarChar(20)
  firstName                      String?                 @db.VarChar(100)
  lastName                       String?                 @db.VarChar(100)
  isActive                       Boolean                 @default(true)
  phoneVerifiedAt                DateTime?               @db.Timestamptz(3)
  lastLoginAt                    DateTime?               @db.Timestamptz(3)
  createdAt                      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt                      DateTime?               @db.Timestamptz(3)
  roles                          UserRole[]
  sessions                       AuthSession[]
  inventoryMovements             InventoryMovement[]     @relation("InventoryMovementActor")
  priceChanges                   ProductPriceHistory[]   @relation("ProductPriceHistoryActor")
  platingRateChanges             PlatingRateHistory[]    @relation("PlatingRateHistoryActor")
  orders                         Order[]
  orderStatusChanges             OrderStatusHistory[]    @relation("OrderStatusHistoryActor")
  addresses                      UserAddress[]
  shipmentStatusChanges          ShipmentStatusHistory[] @relation("ShipmentStatusHistoryActor")
  paymentGatewaySettingChanges   PaymentGatewaySetting[] @relation("PaymentGatewaySettingUpdater")
  paymentReconciliationsResolved PaymentReconciliation[] @relation("PaymentReconciliationResolver")

  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(100)
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?        @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  description String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  grantedAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum OtpPurpose {
  AUTHENTICATION
}

model OtpChallenge {
  id            String     @id @default(uuid()) @db.Uuid
  phone         String     @db.VarChar(20)
  purpose       OtpPurpose
  codeHash      String     @db.VarChar(64)
  expiresAt     DateTime   @db.Timestamptz(3)
  attempts      Int        @default(0)
  maxAttempts   Int        @default(5)
  consumedAt    DateTime?  @db.Timestamptz(3)
  invalidatedAt DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model UserAddress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  title         String    @db.VarChar(100)
  recipientName String    @db.VarChar(150)
  phone         String    @db.VarChar(20)
  province      String    @db.VarChar(100)
  city          String    @db.VarChar(100)
  addressLine   String    @db.VarChar(1000)
  postalCode    String    @db.VarChar(20)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([userId, deletedAt])
  @@map("user_addresses")
}

enum SizeMode {
  NONE
  FREE_SIZE
  SIZED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Media {
  id             String         @id @default(uuid()) @db.Uuid
  storageKey     String         @unique @db.VarChar(500)
  originalName   String?        @db.VarChar(255)
  mimeType       String         @db.VarChar(100)
  width          Int?
  height         Int?
  sizeBytes      Int
  altText        String?        @db.VarChar(255)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?      @db.Timestamptz(3)
  categoryImages Category[]     @relation("CategoryImage")
  brandImages    Brand[]        @relation("BrandImage")
  countryImages  Country[]      @relation("CountryImage")
  productMedia   ProductMedia[]

  @@index([deletedAt])
  @@map("media")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(150)
  slug        String            @unique @db.VarChar(180)
  description String?
  parentId    String?           @db.Uuid
  imageId     String?           @db.Uuid
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?         @db.Timestamptz(3)
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  image       Media?            @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  products    ProductCategory[]

  @@index([parentId])
  @@index([imageId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(180)
  description String?
  imageId     String?   @db.Uuid
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  image       Media?    @relation("BrandImage", fields: [imageId], references: [id], onDelete: SetNull)
  products    Product[]

  @@index([imageId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("brands")
}

model Country {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(160)
  isoCode   String    @unique @db.Char(2)
  imageId   String?   @db.Uuid
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  image     Media?    @relation("CountryImage", fields: [imageId], references: [id], onDelete: SetNull)
  products  Product[]

  @@index([imageId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("countries")
}

model Size {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique @db.VarChar(50)
  label     String           @db.VarChar(100)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?        @db.Timestamptz(3)
  variants  ProductVariant[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("sizes")
}

model Product {
  id               String                @id @default(uuid()) @db.Uuid
  name             String                @db.VarChar(200)
  slug             String                @unique @db.VarChar(220)
  shortDescription String?
  description      String?
  status           ProductStatus         @default(DRAFT)
  sizeMode         SizeMode              @default(NONE)
  brandId          String?               @db.Uuid
  countryId        String?               @db.Uuid
  salePriceToman   Int?
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?             @db.Timestamptz(3)
  brand            Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  country          Country?              @relation(fields: [countryId], references: [id], onDelete: SetNull)
  categories       ProductCategory[]
  variants         ProductVariant[]
  media            ProductMedia[]
  suppliers        ProductSupplier[]
  priceHistory     ProductPriceHistory[]

  @@index([brandId])
  @@index([countryId])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id              String                 @id @default(uuid()) @db.Uuid
  productId       String                 @db.Uuid
  sizeId          String?                @db.Uuid
  sku             String                 @unique @db.VarChar(100)
  name            String?                @db.VarChar(150)
  weightGrams     Decimal?               @db.Decimal(10, 3)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?              @db.Timestamptz(3)
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            Size?                  @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  inventories     Inventory[]
  platingEligible Boolean                @default(false)
  platingOptions  ProductPlatingOption[]
  orderItems      OrderItem[]

  @@unique([productId, sizeId])
  @@index([productId, isActive])
  @@index([sizeId])
  @@index([deletedAt])
  @@map("product_variants")
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductMedia {
  productId String  @db.Uuid
  mediaId   String  @db.Uuid
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  altText   String? @db.VarChar(255)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
  @@map("product_media")
}

enum InventoryMovementType {
  ADJUSTMENT
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  CANCELLATION
}

model Warehouse {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique @db.VarChar(64)
  name      String      @db.VarChar(150)
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?   @db.Timestamptz(3)
  inventory Inventory[]
  orders    Order[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("warehouses")
}

model Inventory {
  id                String              @id @default(uuid()) @db.Uuid
  warehouseId       String              @db.Uuid
  variantId         String              @db.Uuid
  onHand            Int                 @default(0)
  reserved          Int                 @default(0)
  lowStockThreshold Int                 @default(0)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([warehouseId, onHand])
  @@map("inventory")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  inventoryId   String                @db.Uuid
  actorUserId   String?               @db.Uuid
  type          InventoryMovementType
  onHandDelta   Int                   @default(0)
  reservedDelta Int                   @default(0)
  onHandAfter   Int
  reservedAfter Int
  reason        String?               @db.VarChar(500)
  referenceType String?               @db.VarChar(64)
  referenceId   String?               @db.Uuid
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  inventory     Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  actor         User?                 @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([actorUserId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model Supplier {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(64)
  name        String            @db.VarChar(150)
  contactName String?           @db.VarChar(150)
  phone       String?           @db.VarChar(20)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?         @db.Timestamptz(3)
  products    ProductSupplier[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("suppliers")
}

model ProductSupplier {
  productId          String   @db.Uuid
  supplierId         String   @db.Uuid
  supplierPriceToman Int
  markupPercent      Decimal? @db.Decimal(7, 3)
  isPreferred        Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier           Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@id([productId, supplierId])
  @@index([supplierId, isActive])
  @@index([productId, isPreferred])
  @@map("product_suppliers")
}

model ProductPriceHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @db.Uuid
  changedByUserId    String?  @db.Uuid
  previousPriceToman Int?
  newPriceToman      Int
  reason             String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  changedBy          User?    @relation("ProductPriceHistoryActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([changedByUserId])
  @@map("product_price_history")
}

enum PlatingType {
  GOLD
  RHODIUM
}

model PlatingRate {
  id                String                 @id @default(uuid()) @db.Uuid
  type              PlatingType            @unique
  pricePerGramToman Int
  leadTimeDays      Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  history           PlatingRateHistory[]
  options           ProductPlatingOption[]

  @@index([isActive])
  @@map("plating_rates")
}

model PlatingRateHistory {
  id                        String      @id @default(uuid()) @db.Uuid
  platingRateId             String      @db.Uuid
  changedByUserId           String?     @db.Uuid
  previousPricePerGramToman Int?
  newPricePerGramToman      Int
  previousLeadTimeDays      Int?
  newLeadTimeDays           Int
  reason                    String?     @db.VarChar(500)
  createdAt                 DateTime    @default(now()) @db.Timestamptz(3)
  platingRate               PlatingRate @relation(fields: [platingRateId], references: [id], onDelete: Restrict)
  changedBy                 User?       @relation("PlatingRateHistoryActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([platingRateId, createdAt])
  @@index([changedByUserId])
  @@map("plating_rate_history")
}

model ProductPlatingOption {
  variantId     String         @db.Uuid
  platingRateId String         @db.Uuid
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  platingRate   PlatingRate    @relation(fields: [platingRateId], references: [id], onDelete: Restrict)

  @@id([variantId, platingRateId])
  @@index([platingRateId, isActive])
  @@map("product_plating_options")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

model Order {
  id                    String               @id @default(uuid()) @db.Uuid
  orderNumber           String               @unique @db.VarChar(32)
  userId                String               @db.Uuid
  warehouseId           String               @db.Uuid
  status                OrderStatus          @default(PENDING_PAYMENT)
  merchandiseTotalToman Int
  platingTotalToman     Int                  @default(0)
  discountTotalToman    Int                  @default(0)
  shippingTotalToman    Int                  @default(0)
  taxTotalToman         Int                  @default(0)
  grandTotalToman       Int
  reservationExpiresAt  DateTime             @db.Timestamptz(3)
  paidAt                DateTime?            @db.Timestamptz(3)
  cancelledAt           DateTime?            @db.Timestamptz(3)
  deliveredAt           DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  warehouse             Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shippingAddress       OrderAddress?
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payment               Payment?
  shipment              Shipment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([reservationExpiresAt])
  @@map("orders")
}

model OrderAddress {
  orderId       String @id @db.Uuid
  recipientName String @db.VarChar(150)
  phone         String @db.VarChar(20)
  province      String @db.VarChar(100)
  city          String @db.VarChar(100)
  addressLine   String @db.VarChar(1000)
  postalCode    String @db.VarChar(20)
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id                     String         @id @default(uuid()) @db.Uuid
  orderId                String         @db.Uuid
  variantId              String         @db.Uuid
  quantity               Int
  productNameSnapshot    String         @db.VarChar(200)
  variantNameSnapshot    String?        @db.VarChar(150)
  skuSnapshot            String         @db.VarChar(100)
  sizeLabelSnapshot      String?        @db.VarChar(100)
  unitSalePriceToman     Int
  unitSupplierPriceToman Int?
  supplierIdSnapshot     String?        @db.Uuid
  supplierNameSnapshot   String?        @db.VarChar(150)
  platingType            PlatingType?
  platingWeightGrams     Decimal?       @db.Decimal(10, 3)
  platingRateToman       Int?
  unitPlatingPriceToman  Int            @default(0)
  platingLeadTimeDays    Int?
  unitWeightGrams        Decimal?       @db.Decimal(10, 3)
  lineTotalToman         Int
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant                ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  actorUserId String?      @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User?        @relation("OrderStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId])
  @@map("order_status_history")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  RECONCILIATION_REQUIRED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECTED
  VERIFIED
  FAILED
  RECONCILIATION_REQUIRED
  RECONCILED
}

model Payment {
  id          String           @id @default(uuid()) @db.Uuid
  orderId     String           @unique @db.Uuid
  status      PaymentStatus    @default(PENDING)
  amountToman Int
  paidAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts    PaymentAttempt[]

  @@index([status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String                 @id @default(uuid()) @db.Uuid
  paymentId         String                 @db.Uuid
  idempotencyKey    String                 @unique @db.VarChar(120)
  provider          String                 @db.VarChar(64)
  status            PaymentAttemptStatus   @default(CREATED)
  amountToman       Int
  authority         String?                @db.VarChar(255)
  paymentUrl        String?                @db.VarChar(2000)
  providerReference String?                @db.VarChar(255)
  failureCode       String?                @db.VarChar(120)
  failureMessage    String?                @db.VarChar(500)
  verifiedAt        DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  payment           Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reconciliation    PaymentReconciliation?

  @@unique([provider, authority])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

enum PaymentReconciliationStatus {
  OPEN
  RESOLVED
}

enum PaymentReconciliationResolution {
  REFUNDED_EXTERNALLY
}

model PaymentReconciliation {
  id                  String                           @id @default(uuid()) @db.Uuid
  paymentAttemptId    String                           @unique @db.Uuid
  provider            String                           @db.VarChar(64)
  providerReference   String                           @db.VarChar(255)
  amountToman         Int
  detectedOrderStatus OrderStatus
  reason              String                           @db.VarChar(500)
  status              PaymentReconciliationStatus      @default(OPEN)
  resolution          PaymentReconciliationResolution?
  resolutionNote      String?                          @db.VarChar(1000)
  resolvedByUserId    String?                          @db.Uuid
  resolvedAt          DateTime?                        @db.Timestamptz(3)
  createdAt           DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                         @updatedAt @db.Timestamptz(3)
  paymentAttempt      PaymentAttempt                   @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  resolvedBy          User?                            @relation("PaymentReconciliationResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([resolvedByUserId])
  @@map("payment_reconciliations")
}

model PaymentGatewaySetting {
  provider        String   @id @db.VarChar(64)
  isEnabled       Boolean  @default(false)
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  updatedBy       User?    @relation("PaymentGatewaySettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([isEnabled])
  @@index([updatedByUserId])
  @@map("payment_gateway_settings")
}

enum ShipmentStatus {
  PENDING
  READY
  HANDED_OVER
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum ShipmentProviderCreationState {
  NOT_STARTED
  IN_PROGRESS
  CREATED
  UNKNOWN
}

model Shipment {
  id                      String                        @id @default(uuid()) @db.Uuid
  orderId                 String                        @unique @db.Uuid
  provider                String                        @db.VarChar(64)
  providerServiceCode     String                        @db.VarChar(120)
  providerServiceName     String?                       @db.VarChar(200)
  status                  ShipmentStatus                @default(PENDING)
  providerCreationState   ShipmentProviderCreationState @default(NOT_STARTED)
  shippingCostToman       Int
  totalWeightGrams        Decimal                       @db.Decimal(12, 3)
  estimatedDeliveryDays   Int?
  providerShipmentId      String?                       @db.VarChar(255)
  trackingCode            String?                       @db.VarChar(255)
  providerCreateError     String?                       @db.VarChar(500)
  creationAttemptedAt     DateTime?                     @db.Timestamptz(3)
  lastProviderStatus      String?                       @db.VarChar(255)
  lastProviderDescription String?                       @db.VarChar(500)
  lastTrackingSyncAt      DateTime?                     @db.Timestamptz(3)
  shippedAt               DateTime?                     @db.Timestamptz(3)
  deliveredAt             DateTime?                     @db.Timestamptz(3)
  createdAt               DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                      @updatedAt @db.Timestamptz(3)
  order                   Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  statusHistory           ShipmentStatusHistory[]

  @@index([status, createdAt])
  @@index([providerCreationState, creationAttemptedAt])
  @@index([provider, providerShipmentId])
  @@index([trackingCode])
  @@map("shipments")
}

model ShipmentStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  shipmentId  String          @db.Uuid
  actorUserId String?         @db.Uuid
  fromStatus  ShipmentStatus?
  toStatus    ShipmentStatus
  reason      String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  shipment    Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor       User?           @relation("ShipmentStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId, createdAt])
  @@index([actorUserId])
  @@map("shipment_status_history")
}
