NODE_ENV=development
HOST=0.0.0.0
PORT=3000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Development stores files locally under apps/api/.data/media (relative to the API process).
# Production must use an absolute persistent VPS path, e.g. /var/lib/hamidian-silver/media.
MEDIA_STORAGE_ROOT=.data/media
# The API serves MEDIA_STORAGE_ROOT at /media. In production use the public API/reverse-proxy URL.
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
DATABASE_URL=postgresql://hamidian:hamidian_silver_dev@127.0.0.1:5432/hamidian_silver?schema=public
OTP_PEPPER=replace-with-at-least-32-random-characters
# Local development: console (prints OTP in the API terminal)
# Production: kavenegar
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=
KAVENEGAR_PAYMENT_VERIFIED_TEMPLATE=hamidianpayment
KAVENEGAR_PAYMENT_RECEIPT_SUBMITTED_TEMPLATE=hamidianreceipt
KAVENEGAR_PAYMENT_RECEIPT_REJECTED_TEMPLATE=hamidianreceiptrejected
KAVENEGAR_SHIPMENT_TRACKING_TEMPLATE=hamidiantracking
KAVENEGAR_ORDER_SHIPPED_TEMPLATE=hamidianshipped
KAVENEGAR_ORDER_DELIVERED_TEMPLATE=hamidiandelivered
KAVENEGAR_ORDER_CANCELLED_TEMPLATE=hamidiancancelled
ADMIN_APP_ORIGIN=http://localhost:3002
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
BALE_BOT_TOKEN=
ADMIN_MESSAGING_REQUEST_TIMEOUT_MS=8000
AUTH_SESSION_TTL_DAYS=30
PAYMENT_PROVIDER=disabled
# Gateway callbacks terminate at the Storefront BFF and are verified by the API from there.
PAYMENT_CALLBACK_URL=http://localhost:3001/api/payment/callback
IRANDARGAH_API_TOKEN=
IRANDARGAH_SANDBOX=true
IRANDARGAH_REQUEST_TIMEOUT_MS=8000
# Mellat requires all three credentials before it can be enabled in Admin.
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
MELLAT_SOAP_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw
MELLAT_START_PAY_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat
MELLAT_REQUEST_TIMEOUT_MS=10000
SHIPPING_PROVIDER=disabled
# Optional fallback until shipping pricing is saved from the admin panel.
MANUAL_SHIPPING_COST_TOMAN=0
POSTEX_API_BASE_URL=https://api.postex.ir/api/v1
POSTEX_TRACKING_BASE_URL=https://api.postex.ir/api/app/v1
POSTEX_API_KEY=
POSTEX_ORIGIN_CITY_CODE=
POSTEX_ORIGIN_CITY_NAME=
POSTEX_ORIGIN_POSTAL_CODE=
POSTEX_ORIGIN_ADDRESS=
POSTEX_ORIGIN_FIRST_NAME=
POSTEX_ORIGIN_LAST_NAME=
POSTEX_ORIGIN_MOBILE=
POSTEX_ORIGIN_PHONE=
POSTEX_ORIGIN_COMPANY_NAME=
POSTEX_BOX_TYPE_ID=
POSTEX_COLLECTION_TYPE=
POSTEX_PAYMENT_TYPE=SENDER
POSTEX_REQUEST_TIMEOUT_MS=15000
