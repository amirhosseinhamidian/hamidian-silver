# TEMPLATE ONLY: /etc/hamidian-silver/staging.env, root:root 0600, never Git.
# Never copy production secrets, customer data, merchant live credentials or backups.
POSTGRES_DB=hamidian_staging
POSTGRES_USER=hamidian_staging
POSTGRES_PASSWORD=
DATABASE_URL=
OTP_PEPPER=
MEDIA_PUBLIC_BASE_URL=https://media.staging.hamidian.shop/media
CORS_ORIGINS=https://staging.hamidian.shop,https://admin.staging.hamidian.shop
PAYMENT_CALLBACK_URL=https://staging.hamidian.shop/api/payment/callback
# Disabled until test SMS credentials are provided; console is forbidden.
SMS_PROVIDER=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=
# Gateway enabled only via staging Admin/DB. Sandbox is mandatory.
PAYMENT_PROVIDER=disabled
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ZIBAL_MERCHANT_ID=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
SHIPPING_PROVIDER=disabled
MANUAL_SHIPPING_COST_TOMAN=0
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
