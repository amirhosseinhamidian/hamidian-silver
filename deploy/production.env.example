# TEMPLATE ONLY. Keep real values root-owned, mode 0600, at /etc/hamidian-silver/production.env.
# Generate separate random secrets; percent-encode special password characters in DATABASE_URL.
# Never copy real values into Git, build args, GitHub Actions secrets, or support tickets.
POSTGRES_DB=hamidian_silver
POSTGRES_USER=hamidian
POSTGRES_PASSWORD=
# Use postgresql://hamidian:<same encoded password>@postgres:5432/hamidian_silver?schema=public
DATABASE_URL=
OTP_PEPPER=

# These URLs are public, but the file itself contains private credentials.
MEDIA_PUBLIC_BASE_URL=https://media.hamidian.shop/media
CORS_ORIGINS=https://hamidian.shop,https://admin.hamidian.shop
PAYMENT_CALLBACK_URL=https://hamidian.shop/api/payment/callback

# Keep disabled for infrastructure setup; SMS must use a real provider before go-live.
SMS_PROVIDER=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
# Optional sender number for non-OTP transactional messages.
KAVENEGAR_SENDER=
# Gateway activation is controlled via Admin/DB; keep this legacy flag disabled.
# Only configure credentials for ONE gateway for the initial low-value payment.
PAYMENT_PROVIDER=disabled
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ZIBAL_MERCHANT_ID=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=

# Postex deliberately disabled. Set a fixed cost in toman or zero for free delivery.
SHIPPING_PROVIDER=disabled
MANUAL_SHIPPING_COST_TOMAN=0
# Public build-time values, NOT secrets; a change requires rebuilding Storefront.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
