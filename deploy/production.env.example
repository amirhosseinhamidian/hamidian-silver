# Copy to /etc/hamidian-silver/production.env on the VPS; chmod 600; never commit real values.
# For DATABASE_URL, percent-encode special characters in the database password.
POSTGRES_DB=hamidian_silver
POSTGRES_USER=hamidian
POSTGRES_PASSWORD=
DATABASE_URL=
OTP_PEPPER=

# These URLs are public, but the file itself contains private credentials.
MEDIA_PUBLIC_BASE_URL=https://media.hamidian.shop/media
CORS_ORIGINS=https://hamidian.shop,https://admin.hamidian.shop
PAYMENT_CALLBACK_URL=https://hamidian.shop/api/payment/callback

# Keep disabled for infrastructure setup; SMS must use a real provider before go-live.
SMS_PROVIDER=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
PAYMENT_PROVIDER=disabled
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ZIBAL_MERCHANT_ID=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=

# Postex deliberately disabled. Set a fixed cost in toman or zero for free delivery.
MANUAL_SHIPPING_COST_TOMAN=0
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
