# Docker development infrastructure
POSTGRES_DB=hamidian_silver
POSTGRES_USER=hamidian
POSTGRES_PASSWORD=hamidian_silver_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

# Prisma CLI
DATABASE_URL=postgresql://hamidian:hamidian_silver_dev@127.0.0.1:5432/hamidian_silver?schema=public
HAMIDIAN_API_ORIGIN=http://localhost:3000
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
STOREFRONT_PUBLIC_ORIGIN=http://localhost:3001
# Optional HTML verification token for Google Search Console.
GOOGLE_SITE_VERIFICATION=
# Optional GA4 measurement ID. Analytics stays disabled when this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Operational bootstrap (run explicitly with `pnpm db:seed:operations`).
# Keep real values and all gateway credentials outside Git.
OPERATIONAL_ADMIN_PHONE=
OPERATIONAL_ADMIN_FIRST_NAME=
OPERATIONAL_ADMIN_LAST_NAME=
OPERATIONAL_WAREHOUSE_CODE=MAIN
OPERATIONAL_WAREHOUSE_NAME=انبار اصلی
OPERATIONAL_SITE_NAME=نقره حمیدیان
OPERATIONAL_FOOTER_ABOUT=
OPERATIONAL_CONTACT_ADDRESS=
OPERATIONAL_CONTACT_PHONES=
OPERATIONAL_CONTACT_EMAIL=
OPERATIONAL_INSTAGRAM_URL=
OPERATIONAL_TELEGRAM_URL=
OPERATIONAL_BALE_URL=

# Keep `disabled` until one real gateway is configured and ready for a low-value test.
# Allowed values: disabled, zarinpal, zibal, mellat
OPERATIONAL_PAYMENT_GATEWAY=disabled
ZARINPAL_MERCHANT_ID=
ZIBAL_MERCHANT_ID=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=

# Manual shipping remains active while Postex is disabled. Use 0 for free shipping.
SHIPPING_PROVIDER=disabled
MANUAL_SHIPPING_COST_TOMAN=0
